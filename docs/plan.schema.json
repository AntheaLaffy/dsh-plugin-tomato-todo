{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tomato Todo Plan v7",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "pomodoroMinutes", "projects", "tasks"],
  "properties": {
    "format": {
      "const": "tomato-todo-plan"
    },
    "version": {
      "const": 7
    },
    "pomodoroMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 180
    },
    "replace": {
      "type": "boolean"
    },
    "projects": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "blocks": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "habits": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/habit"
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "color"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "appWhitelist": {
          "type": "array",
          "maxItems": 100,
          "description": "应用 ID 精确匹配；提供即启用该项目专属白名单并覆盖旧值，省略则不改动本机列表。",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "notes": {
          "type": "string",
          "maxLength": 50000,
          "description": "Rust additionally limits UTF-8 bytes to 50000."
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "dueDate": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0
        },
        "estimate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "default": 1
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "subtasks": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/subtask"
          }
        },
        "repeat": {
          "type": "string",
          "enum": ["none", "daily", "weekdays", "weekly"],
          "default": "none"
        },
        "reminderTime": {
          "type": ["string", "null"],
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "default": null
        },
        "focusMinutes": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 180,
          "default": null
        },
        "habitId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "recurring": {
          "type": "boolean",
          "default": false
        },
        "scrapMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080,
          "default": 0
        },
        "repeatDays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "maxItems": 7,
          "uniqueItems": true,
          "default": []
        },
        "expiryDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36500,
          "default": 0
        }
      }
    },
    "subtask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        }
      }
    },
    "print": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "date"],
      "properties": {
        "templateId": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        }
      }
    },
    "habit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "days", "start", "end"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        },
        "start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "attention": {
          "enum": ["required", "light"],
          "default": "required"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "tasks": {
            "items": {
              "properties": {
                "reminderTime": {
                  "type": "null"
                },
                "focusMinutes": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "enum": [1, 2]
          }
        }
      },
      "then": {
        "properties": {
          "templates": {
            "maxItems": 0
          },
          "prints": {
            "maxItems": 0
          },
          "habits": {
            "maxItems": 0
          },
          "tasks": {
            "items": {
              "properties": {
                "templateId": {
                  "type": "null"
                },
                "habitId": {
                  "type": "null"
                },
                "recurring": {
                  "const": false
                },
                "scrapMinutes": {
                  "const": 0
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "enum": [3, 4]
          }
        }
      },
      "then": {
        "properties": {
          "tasks": {
            "items": {
              "properties": {
                "repeat": {
                  "const": "none"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "enum": [1, 2, 3]
          }
        }
      },
      "then": {
        "properties": {}
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "enum": [1, 2, 3, 4]
          }
        }
      },
      "then": {
        "properties": {
          "blocks": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
